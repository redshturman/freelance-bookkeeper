<Window x:Class="FreelanceBookkeeper.Views.ExpenseView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Despeses" Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="MonthGroupComboBox"
                      Width="160"
                      ItemsSource="{Binding MonthGroups}"
                      DisplayMemberPath="Display"
                      SelectedIndex="-1"
                      SelectionChanged="MonthGroupComboBox_SelectionChanged"/>
            <ComboBox
                x:Name="YearComboBox"
                Width="120"
                ItemsSource="{Binding Years}"
                SelectionChanged="YearComboBox_SelectionChanged"
                SelectedIndex="-1"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Guardar" Width="100" Height="25" Click="SaveButton_Click" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                <Button Content="Exportar a Excel" Width="120" Height="25" Click="ExportButton_Click" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                <Button Content="Enviar per Correu" Width="130" Height="25" Click="SendEmailButton_Click" HorizontalAlignment="Left"/>
            </StackPanel>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="20,0,0,0" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Base Imponible:" FontWeight="SemiBold" Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalBaseAmount, StringFormat={}{0:N2} €}" HorizontalAlignment="Right" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total IVA (21%):" FontWeight="SemiBold" Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalTaxAmount, StringFormat={}{0:N2} €}" HorizontalAlignment="Right" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total:" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalAmount, StringFormat={}{0:N2} €}" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </StackPanel>

        <DataGrid Grid.Row="2" 
                  x:Name="ExpenseDataGrid"
                  ItemsSource="{Binding Expenses}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserSortColumns="True"> 
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Data" SortMemberPath="ExpenseDate">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ExpenseDate, StringFormat=dd/MM/yyyy}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding ExpenseDateAsDateTime, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Concepte" Binding="{Binding Description}" />
                <DataGridTextColumn Header="Nom Proveidor" Binding="{Binding SupplierName}" />
                <DataGridTextColumn Header="DNI/NIE Proveidor" Binding="{Binding SupplierId}" />
                <DataGridTextColumn Header="Base Imponible" Binding="{Binding BaseAmount, StringFormat={}{0:N2}, Mode=OneWay}" IsReadOnly="True" />
                <DataGridTextColumn Header="Import IVA (21%)" Binding="{Binding TaxAmount, StringFormat={}{0:N2}, Mode=OneWay}" IsReadOnly="True" />
                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" />
                <DataGridTemplateColumn Header="Accions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Duplicar"
                                        Click="DuplicateButton_Click" 
                                        Tag="{Binding}"
                                        Margin="0,0,5,0" />
                                <Button Content="Borrar"
                                        Click="DeleteButton_Click" 
                                        Tag="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
